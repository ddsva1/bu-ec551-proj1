.model pos2
.inputs a b c d e #[REPLACE WITH INPUTS SEPARATED BY SPACES]  #(may repeat)
.outputs f   #can change name of output

.names a b temp1 #<in1> ... <out>       #followed by single-output cover rows:
1- 1   #input pattern (0/1/-) and output value
-1 1   #(constant node: no inputs)

.names a c temp2 #<in1> ... <out>       #followed by single-output cover rows:
0- 1   #input pattern (0/1/-) and output value
-1 1   #(constant node: no inputs)

.names d e temp3 #<in1> ... <out>       #followed by single-output cover rows:
1- 1   #input pattern (0/1/-) and output value
-1 1   #(constant node: no inputs)

.names temp1 temp2 temp3 f #<in1> ... <out>       #followed by single-output cover rows:
111 1   #input pattern (0/1/-) and output value


.end
#'#' comments and '\\' line continuation.