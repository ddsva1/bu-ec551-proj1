# 7-bit ripple-carry adder: {cout, s6..s0} = a6..a0 + b6..b0 + cin
# Built from 7 one-bit full adders; carry c(i+1) feeds the next stage.
.model adder7
.inputs a6 a5 a4 a3 a2 a1 a0 b6 b5 b4 b3 b2 b1 b0 cin
.outputs s0 s1 s2 s3 s4 s5 s6 cout

# bit 0: s0 = a0 xor b0 xor cin
.names a0 b0 cin s0
100 1
010 1
001 1
111 1
# bit 0: c1 = majority(a0, b0, cin)
.names a0 b0 cin c1
11- 1
1-1 1
-11 1

# bit 1: s1 = a1 xor b1 xor c1
.names a1 b1 c1 s1
100 1
010 1
001 1
111 1
# bit 1: c2 = majority(a1, b1, c1)
.names a1 b1 c1 c2
11- 1
1-1 1
-11 1

# bit 2: s2 = a2 xor b2 xor c2
.names a2 b2 c2 s2
100 1
010 1
001 1
111 1
# bit 2: c3 = majority(a2, b2, c2)
.names a2 b2 c2 c3
11- 1
1-1 1
-11 1

# bit 3: s3 = a3 xor b3 xor c3
.names a3 b3 c3 s3
100 1
010 1
001 1
111 1
# bit 3: c4 = majority(a3, b3, c3)
.names a3 b3 c3 c4
11- 1
1-1 1
-11 1

# bit 4: s4 = a4 xor b4 xor c4
.names a4 b4 c4 s4
100 1
010 1
001 1
111 1
# bit 4: c5 = majority(a4, b4, c4)
.names a4 b4 c4 c5
11- 1
1-1 1
-11 1

# bit 5: s5 = a5 xor b5 xor c5
.names a5 b5 c5 s5
100 1
010 1
001 1
111 1
# bit 5: c6 = majority(a5, b5, c5)
.names a5 b5 c5 c6
11- 1
1-1 1
-11 1

# bit 6: s6 = a6 xor b6 xor c6
.names a6 b6 c6 s6
100 1
010 1
001 1
111 1
# bit 6: cout = majority(a6, b6, c6)
.names a6 b6 c6 cout
11- 1
1-1 1
-11 1

.end
